{
	"manifest_version": 3,
	"name": "Comic Grabber",
	"version": "3.0.0",
	"default_locale": "ko",
	"description": "__MSG_extensionDescription__",
	"author": "Isitea",
	"icons": {
		"128": "icon-128.png"
	},
	"permissions": [
		"downloads",
		"scripting"
	],
	"browser_action": {
		"default_title": "__MSG_toggleMode__"
	},
	"content_scripts": [
		{
			"matches": [
				"https://*toki*/*",
				"https://comic.naver.com/*",
				"https://webtoon.daum.net/*"
			],
			"js": [
				"app/injector.js"
			],
			"run_at": "document_end",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"resources": [ "*" ],
			"matches": [ "https://*/*" ]
		}
	],
	"background": {
		"service_worker": "services/serviceProvider.js"
	},
	"host_permissions": [
		"https://*toki*/*",
		"https://comic.naver.com/*",
		"https://webtoon.daum.net/*"
	]
}